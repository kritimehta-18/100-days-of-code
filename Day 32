}
Q64: Find the digit that occurs the most times in an integer number.

/*
#include <stdio.h>

int main() {
    long long n;
    int count[10] = {0};

    scanf("%lld", &n);

    if (n == 0) {
        printf("0");
        return 0;
    }

    while (n > 0) {
        int digit = n % 10;
        count[digit]++;
        n /= 10;
    }

    int max = count[0];
    int result = 0;

    for (int i = 1; i < 10; i++) {
        if (count[i] > max) {
            max = count[i];
            result = i;
        }
    }

    printf("%d", result);

    return 0;
}
